{
  "name": "voice",
  "private": true,
  "workspaces": ["mock_design", "frontend"],
  "scripts": {
    "dev": "npm --workspace frontend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:backend": "uv run --package voice-backend voice-backend-dev",
    "dev:mock": "npm --workspace mock_design run dev",
    "build": "npm --workspace frontend run build",
    "build:frontend": "npm --workspace frontend run build",
    "build:mock": "npm --workspace mock_design run build",
    "start": "npm --workspace frontend run start",
    "start:frontend": "npm --workspace frontend run start",
    "db:migrate": "uv run --package voice-migrator voice-migrate upgrade head",
    "db:seed": "uv run --package voice-migrator voice-seed",
    "db:verify": "uv run --package voice-migrator voice-db-verify",
    "test:frontend": "npm --workspace frontend run test",
    "typecheck:frontend": "npm --workspace frontend run typecheck",
    "test:e2e": "playwright test",
    "check": "npm run typecheck:frontend && npm run test:frontend && npm run build",
    "review:end-to-end": "make review-end-2-end"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}
