VOICE_PIPELINE_MIN_INTERRUPTION_WORDS=1
VOICE_PIPELINE_FALSE_INTERRUPTION_TIMEOUT_MS=1800
VOICE_PIPELINE_FALSE_INTERRUPTION_RECOVERY=true
VOICE_PIPELINE_BACKCHANNEL_BOUNDARY_MS=500
VOICE_PIPELINE_PREEMPTIVE_GENERATION=false
VOICE_PIPELINE_PREEMPTIVE_TTS=false
VOICE_PIPELINE_PREEMPTIVE_MAX_SPEECH_DURATION_MS=10000
VOICE_PIPELINE_PREEMPTIVE_MAX_RETRIES=1
