{
  "name": "voice-frontend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "rm -rf .next tsconfig.tsbuildinfo tsconfig.typecheck.tsbuildinfo && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run --pool forks",
    "test:watch": "vitest"
  },
  "dependencies": {
    "livekit-client": "^2.22.0",
    "lucide-react": "^0.542.0",
    "next": "^15.4.6",
